# Supabase project settings
# Get these from your Supabase project's Connect panel.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The frontend calls Supabase Edge Functions.
VITE_SUPABASE_AI_FUNCTION=ai-tutor
VITE_SUPABASE_DELETE_STUDENT_FUNCTION=delete-student
